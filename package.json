{
  "name": "buildspace-backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "test": "jest --detectOpenHandles --forceExit",
    "prepare": "husky",
    "dev": "nodemon -r dotenv/config server.js dotenv_config_path=env/.env.dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "docker:network": "docker network create buildspace_network",
    "docker:db": "docker network connect buildspace_network my-mysql",
    "docker:build": "docker build -t buildspace_backend .",
    "docker:run": "docker run -d --name buildspace_backend --network buildspace_network -p 3000:3000 buildspace_backend",
    "docker:rm": "docker rm buildspace_backend",
    "docker:start": "docker start buildspace_backend",
    "docker:stop": "docker stop buildspace_backend"
  },
  "dependencies": {
    "@teamwork/websocket-json-stream": "^2.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.2.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^7.0.5",
    "nodemon": "^3.1.10",
    "sequelize": "^6.37.7",
    "sharedb-client": "^1.3.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "ws": "^8.18.3",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
